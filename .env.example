# HireTrust production configuration
# MongoDB Atlas is REQUIRED. HireTrust no longer uses database.json.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=hiretrust

# Display/scheduling timezone. Stored timestamps remain UTC.
APP_TIMEZONE=Asia/Kolkata

# SMTP sender account used for interview notifications/results.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=your-sender@gmail.com

# Optional server-side AI provider. Never expose this key in app.js.
OPENAI_API_KEY=

# Public HTTPS URL used in password-reset emails (set this to your Render service URL).
PUBLIC_APP_URL=https://your-service.onrender.com

# Optional: provision a first admin account on startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThis!123
ADMIN_USER_ID=ADMIN-1001
